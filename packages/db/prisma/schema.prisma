// Oxbow data model: the wallets being tracked, the buys and sells read from
// their transactions, and what is known about each token traded.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A wallet Oxbow follows on chain. Featured wallets are picked by the owner;
/// anyone can add others.
model TrackedWallet {
  address        String        @id
  label          String?
  featured       Boolean       @default(false)
  /// How it got here: "owner" (wallets CLI), "user" (pasted on the site) or "discovered" (found profitable by the worker).
  source         String        @default("user")
  /// Turned off when nobody has looked at it for a while (user-added only).
  active         Boolean       @default(true)
  addedAt        DateTime      @default(now())
  /// Last time someone opened its page or followed it.
  lastViewedAt   DateTime      @default(now())
  lastTradeAt    DateTime?
  /// Newest signature already read, so catching up stops there.
  lastSignature  String?
  backfilledAt   DateTime?
  trades         WalletTrade[]

  @@index([active, featured])
}

model WalletTrade {
  id          BigInt        @id @default(autoincrement())
  signature   String
  wallet      String
  trader      TrackedWallet @relation(fields: [wallet], references: [address], onDelete: Cascade)
  ts          DateTime
  slot        BigInt
  side        TradeSide
  mint        String
  /// UI units of the token bought or sold.
  amount      Decimal       @db.Decimal(40, 12)
  quoteMint   String
  quoteAmount Decimal       @db.Decimal(40, 12)
  /// USD value at the time it was read.
  usd         Decimal       @db.Decimal(24, 6)
  priceUsd    Decimal       @db.Decimal(40, 18)

  @@unique([signature, wallet, mint])
  @@index([wallet, ts])
  @@index([mint, ts])
  @@index([ts])
}

/// Token facts from Jupiter's token data (and the chain when Jupiter doesn't know it), refreshed every few minutes.
model TokenMeta {
  mint            String   @id
  symbol          String
  name            String
  decimals        Int
  logoUri         String?
  verified        Boolean  @default(false)
  /// Jupiter tags it as a stablecoin: counted as money in trades.
  stable          Boolean  @default(false)
  usdPrice        Float?
  change24h       Float?
  mcap            Float?
  liquidity       Float?
  holderCount     Int?
  organicScore    Float?
  mintAuthorityOff  Boolean?
  freezeAuthorityOff Boolean?
  topHoldersPct   Float?
  devPct          Float?
  /// When its first pool was created.
  launchedAt      DateTime?
  /// Where the row came from: "jupiter", or a stand-in from "chain" metadata or the "tx" itself.
  source          String   @default("jupiter")
  updatedAt       DateTime
}

enum TradeSide {
  BUY
  SELL
}
