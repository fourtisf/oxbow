{
  "name": "oxbow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @oxbow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @oxbow/web e2e",
    "screens": "pnpm --filter @oxbow/web screens"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
