# Copy to apps/api/.env (API, seed script) and apps/web/.env.production.local (web).
# Never commit real values.

# shared
SOLANA_CLUSTER=devnet            # devnet | mainnet-beta
RPC_URL=                         # server-side RPC (e.g. Helius, key included); empty = Solana's public endpoint, rate-limited
HELIUS_API_KEY=
DATABASE_URL=postgresql://oxbow:oxbow@127.0.0.1:5432/oxbow
REDIS_URL=redis://127.0.0.1:6379

# web (inlined into the browser bundle at build time: public values only)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_LIVE_DATA=           # 1 = read the Oxbow API (real data); empty = sample data. Needs a rebuild.
NEXT_PUBLIC_OXBOW_FEE_LAMPORTS=100000000  # shown in docs and sample mode; live pages use the API's figure
NEXT_PUBLIC_CONTRACT_ADDRESS=    # hero CA box; shows "Coming soon" while empty
NEXT_PUBLIC_X_URL=               # e.g. https://x.com/yourhandle; empty = "Soon" in the footer, no X icon in the nav
NEXT_PUBLIC_TELEGRAM_URL=        # e.g. https://t.me/yourchannel; empty = "Soon"
NEXT_PUBLIC_SITE_URL=https://oxbowflow.com  # canonical origin for share links, sitemap and OG images (default when empty)
NEXT_PUBLIC_BUY_TOKEN_URL=       # "Get <token>" link; {mint} is replaced. Empty = https://jup.ag/swap/SOL-{mint} (check before launch)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=    # analytics off when empty
NEXT_PUBLIC_PLAUSIBLE_SRC=       # optional, for a self-hosted Plausible script
NEXT_PUBLIC_SENTRY_DSN=          # browser error reporting off when empty
NEXT_PUBLIC_MOCK_EMPTY=          # 1 = mock data starts with no pools (launch-day preview)

# web, server only (read at runtime: no rebuild needed)
SENTRY_DSN=                      # server error reporting off when empty
GEO_BLOCKED_COUNTRIES=           # ISO codes, e.g. US,GB,CA. Empty = no region notice. Decide with your lawyer.
GEO_COUNTRY_HEADER=cf-ipcountry  # header your proxy sets with the visitor's country (Cloudflare default)
LEGAL_ENTITY=                    # company name shown in Terms / Privacy / Risk
LEGAL_CONTACT_EMAIL=             # e.g. support@oxbowflow.com, once the mailbox exists
LEGAL_GOVERNING_LAW=             # e.g. "the laws of Singapore"
LEGAL_UPDATED=                   # "last updated" date on the legal pages, e.g. 2026-11-01
IPFS_GATEWAY=                    # for ipfs:// token metadata and logos; empty = https://ipfs.io/ipfs/

API_INTERNAL_URL=                # where server rendering reaches the API; empty = http://127.0.0.1:4000

# api (apps/api/.env)
PORT=4000
HOST=127.0.0.1                   # nginx in front; never expose the API port directly
JUPITER_API_BASE=                # price + swap quote host; empty = https://lite-api.jup.ag (check current Jupiter docs)
PYTH_HERMES_URL=                 # Pyth price service; empty = https://hermes.pyth.network
LOG_LEVEL=info
OXBOW_TREASURY=                  # wallet that receives the Oxbow fee; pool creation is OFF while empty
OXBOW_FEE_LAMPORTS=100000000     # Oxbow fee per pool (0.1 SOL)
PRIORITY_FEE_MICROLAMPORTS=50000 # priority fee on create transactions

# later milestones
HELIUS_WEBHOOK_SECRET=
