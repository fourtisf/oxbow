# Copy the api part to apps/api/.env (API and tracker worker) and the web part to
# apps/web/.env.production.local. Never commit real values.

# ---------------------------------------------------------------- api + worker (apps/api/.env)
DATABASE_URL=postgresql://oxbow:oxbow@127.0.0.1:5432/oxbow
REDIS_URL=redis://127.0.0.1:6379
RPC_URL=                         # Solana mainnet RPC with your key (e.g. https://mainnet.helius-rpc.com/?api-key=...). Empty = public endpoint, slow
RPC_WS_URL=                      # websocket; empty = RPC_URL with https -> wss (right for Helius)
RPC_RPS=5                        # requests a second each process sends (API, worker, CLI). Helius free allows ~10 in all; paid plans more
JUPITER_API_BASE=                # empty = https://lite-api.jup.ag (free, rate-limited)
JUPITER_API_KEY=                 # optional, from portal.jup.ag; set JUPITER_API_BASE=https://api.jup.ag with it
OXBOW_TREASURY=                  # wallet that receives the swap fee; swaps are fee-free while empty
OXBOW_FEE_BPS=50                 # swap fee in basis points of the SOL side (50 = 0.5%)
MAX_TRACKED_WALLETS=1000         # cap on wallets tracked at once
BACKFILL_LIMIT=100               # transactions read when a wallet is first tracked
TRACKER_RESYNC_SEC=300           # catch-up round over every wallet (covers websocket gaps)
WALLET_IDLE_DAYS=14              # wallets you added that nobody follows or opens stop being tracked after this
DISCOVERY_ENABLED=1              # find smart money automatically (0 = off)
DISCOVERY_EVERY_MIN=120          # minutes between discovery rounds once DISCOVERY_MAX are tracked (every 15 until then)
DISCOVERY_EVALS=30               # candidate wallets checked per round (x3 until 10 are found); ~10 RPC credits each on Helius
DISCOVERY_HISTORY_TXS=100        # transactions read from each candidate
DISCOVERY_MIN_PNL_USD=150        # "consistent": 3+ closed positions, win rate >= DISCOVERY_MIN_WIN_RATE, this much realized profit
DISCOVERY_MIN_WIN_RATE=0.5
DISCOVERY_BIG_WIN_USD=1500       # "big win": this much realized profit with no more losses than wins
DISCOVERY_MAX=100                # most discovered wallets tracked at once (each costs a read per transaction it makes; ~100 fits Helius free)
DISCOVERY_DAILY_CALLS=15000      # RPC credits discovery may spend a day, spread over the day; raise on a paid plan, 0 = no limit
IPFS_GATEWAY=                    # for ipfs:// token metadata; empty = https://ipfs.io/ipfs/
PORT=4000
HOST=127.0.0.1                   # nginx in front; never expose the API port directly
LOG_LEVEL=info

# ---------------------------------------------------------------- web (apps/web/.env.production.local)
# Inlined into the browser bundle at build time: public values only.
NEXT_PUBLIC_CONTRACT_ADDRESS=    # Oxbow token CA (hero, nav, footer); shows "CA Coming soon" while empty
NEXT_PUBLIC_OXBOW_FEE_BPS=50     # fee shown in the docs; keep equal to OXBOW_FEE_BPS
NEXT_PUBLIC_X_URL=               # defaults to https://x.com/oxbowflow; set to override
NEXT_PUBLIC_TELEGRAM_URL=        # e.g. https://t.me/yourchannel; empty = "Soon"
NEXT_PUBLIC_SITE_URL=https://oxbowflow.com  # canonical origin for share links, sitemap and OG images
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=    # analytics off when empty
NEXT_PUBLIC_PLAUSIBLE_SRC=       # optional, for a self-hosted Plausible script
NEXT_PUBLIC_SENTRY_DSN=          # browser error reporting off when empty

# Server only (read at runtime: no rebuild needed)
API_INTERNAL_URL=                # where server rendering reaches the API; empty = http://127.0.0.1:4000
SENTRY_DSN=                      # server error reporting off when empty
GEO_BLOCKED_COUNTRIES=           # ISO codes, e.g. US,GB. Empty = no region notice. Decide with your lawyer.
GEO_COUNTRY_HEADER=cf-ipcountry  # header your proxy sets with the visitor's country (Cloudflare default)
LEGAL_ENTITY=                    # company name shown in Terms / Privacy / Risk
LEGAL_CONTACT_EMAIL=             # e.g. support@oxbowflow.com
LEGAL_GOVERNING_LAW=             # e.g. "the laws of Singapore"
LEGAL_UPDATED=                   # "last updated" date on the legal pages
